# Job Radar — Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit actual secret values to the repository.

# ---- Frontend (Vite) ----
VITE_SUPABASE_URL=https://swjyigjjoksqnsnvqtbu.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Supabase Edge Functions ----
# These are pre-populated in the Supabase hosted environment.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_REVIEWER_MODEL=
# JOB_RADAR_CRON_SECRET=

# ---- Alert Email (Resend) ----
# All four must be set for alerts to be enabled.
# If any is missing, alerts fail CLOSED (zero emails sent).
# RESEND_API_KEY=
# ALERT_RECIPIENT=
# ALERT_FROM=
# ALERTS_ENABLED=true
# ALERTS_ACTIVE_AFTER=2026-08-26T00:00:00Z

# ---- Cloudflare Worker ----
# JOB_RADAR_CRON_SECRET=
